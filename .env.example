# Local development (optional): where TradeTrackerBE is running.
# npm run dev and npm run preview forward /api there.
API_URL=http://127.0.0.1:4000

# Deployed builds (for example on Render): the API's public URL, built into the app.
# The API must list this site's address in its CORS_ORIGINS setting.
